---
import Layout from '../../layouts/Layout.astro';
import { STORE_BY_KEY } from '../../data/comparadorZonas.js';
import { loadPrecios } from '../../lib/preciosSeo.js';
import { CATEGORIES } from '../../data/preciosProductos.js';
import { euro, fechaLarga, mesAnio } from '../../lib/preciosFormato.js';
import '../../styles/precios.css';

const { products, updated } = await loadPrecios();
const groups = CATEGORIES
  .map((c) => ({ ...c, items: products.filter((p) => p.category === c.id) }))
  .filter((c) => c.items.length > 0);

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Comparador', item: new URL('/', Astro.site).href },
      { '@type': 'ListItem', position: 2, name: 'Precios', item: new URL('/precios/', Astro.site).href },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Comparativas de precios de productos de supermercado',
    numberOfItems: products.length,
    itemListElement: products.map((p, i) => ({
      '@type': 'ListItem', position: i + 1, name: p.name, url: new URL(`/precios/${p.slug}/`, Astro.site).href,
    })),
  },
];
---

<Layout
  title={`Precios de supermercados: comparativa de ${products.length} productos (${mesAnio(updated)}) | QuéFalta`}
  description={`Compara el precio de leche, huevos, aceite de oliva y ${products.length - 3} productos básicos más en los supermercados de España. Precios actualizados cada semana.`}
  jsonld={schemas}
>
  <div class="pr container">
    <nav class="pr-crumbs" aria-label="Ruta de navegación">
      <ol>
        <li><a href="/">Comparador</a></li>
        <li><span aria-current="page">Precios</span></li>
      </ol>
    </nav>

    <header class="pr-head">
      <span class="pr-eyebrow">Precios de supermercados</span>
      <h1>Qué cuesta la compra en cada supermercado</h1>
      <p class="pr-answer">
        Compara {products.length} productos básicos en los supermercados de España, con el
        precio por kilo, litro o unidad para ver cuál sale de verdad más barato. Para ver
        los precios de tu zona, usa el <a href="/">comparador con tu código postal</a>.
      </p>
      <p class="pr-updated">Actualizado el <time datetime={updated}>{fechaLarga(updated)}</time></p>
    </header>

    {groups.map((g) => (
      <section>
        <h2>{g.name}</h2>
        <div class="pr-cards">
          {g.items.map((p) => (
            <a class="pr-card" href={`/precios/${p.slug}/`}>
              <strong>{p.name}</strong>
              <span>Desde <b>{euro(p.best.ppu)}/{p.unit}</b> en {STORE_BY_KEY[p.best.store].name}</span>
              <small>{p.rows.length} cadenas · hasta {p.spreadPct} % de diferencia</small>
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="pr-disclaimer">
      Precios de referencia de las tiendas online de cada cadena, que pueden variar según
      la zona y la fecha. QuéFalta no está afiliada a ninguna de estas cadenas.
    </p>
  </div>
</Layout>
