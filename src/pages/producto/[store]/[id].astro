---
import Layout from '../../../layouts/Layout.astro';
import ProductPage from '../../../components/comparador/ProductPage.jsx';
import { STORE_BY_KEY } from '../../../data/comparadorZonas.js';
import { loadProductPages, relatedPages } from '../../../lib/productoSeo.js';
import { productParams, productPath } from '../../../lib/productoApi.js';
import { euro } from '../../../lib/preciosFormato.js';
import '../../../styles/comparador.css';
import '../../../styles/producto.css';

// Fichas que se indexan: el mismo producto (EAN) en varias cadenas, generadas
// en HTML al compilar con precios de referencia (ver lib/productoSeo.js). El
// resto de fichas las sirve pages/producto/index.astro (noindex).

export async function getStaticPaths() {
  // En `astro dev` no se generan: cargarlas tarda ~40 s y bloquearía cada
  // primer clic. Las fichas se ven igual por la página 404 (ProductFallback).
  if (import.meta.env.DEV) return [];
  const { pages, updated } = await loadProductPages();
  // Nombre para el <title>: con la marca si el nombre no la lleva («Cerveza 33 cl»
  // de BM → «Mahou Maestra Cerveza 33 cl»). Si aun así dos fichas coinciden, se
  // añade el formato para que cada <title> sea único (guía de Google).
  const named = pages.map((page) => {
    const label = page.detail.label.replace(/[.\s]+$/, '');
    const brand = page.detail.brand?.trim();
    return brand && !label.toLowerCase().includes(brand.toLowerCase()) ? `${brand} ${label}` : label;
  });
  const seen = new Map();
  for (const n of named) seen.set(n.toLowerCase(), (seen.get(n.toLowerCase()) ?? 0) + 1);
  return pages.map((page, i) => {
    const format = page.detail.format;
    const titleName = seen.get(named[i].toLowerCase()) > 1 && format ? `${named[i]} (${format})` : named[i];
    return {
      params: productParams(page.store, page.id),
      props: { ...page, titleName, updated, related: relatedPages(pages, page) },
    };
  });
}

const { store, id, detail: d, same, related, titleName } = Astro.props;
// Página de la cadena en /supermercados/ (Bonpreu i Esclat usa otra clave).
const storeSlug = store === 'esclat' ? 'bonpreu' : store;
const storeName = STORE_BY_KEY[store].name;
const offers = [d, ...same];
const prices = offers.map((o) => o.price);
const low = Math.min(...prices);
const high = Math.max(...prices);
const cheapest = offers.find((o) => o.price === low);
const otherNames = same.map((o) => STORE_BY_KEY[o.store].name);
const listNames = otherNames.length > 1 ? `${otherNames.slice(0, -1).join(', ')} y ${otherNames.at(-1)}` : otherNames[0];

const name = d.label.replace(/[.\s]+$/, '');
const title = `${titleName ?? name}: precio en ${storeName} y ${same.length} supermercados más | QuéFalta`;
// Meta description corta (1–2 frases, guía de Google): sin repetir la cadena
// cuando ella misma es la más barata, y el extra de la ficha solo si cabe.
const cheapestName = STORE_BY_KEY[cheapest.store].name;
const descName = (titleName ?? name).replace(/ \([^)]*\)$/, '');
const joinNames = (list) => list.length > 1 ? `${list.slice(0, -1).join(', ')} y ${list.at(-1)}` : list[0];
const tiedNames = same.filter((o) => o.price === low).map((o) => STORE_BY_KEY[o.store].name);
const restNames = same.filter((o) => o !== cheapest).map((o) => STORE_BY_KEY[o.store].name);
const baseDescription = cheapest === d
  ? `${descName} a ${euro(d.price)} en ${storeName}, ${tiedNames.length ? `el precio más bajo junto a ${joinNames(tiedNames)}` : `más barato que en ${listNames}`}.`
  : [`${descName} a ${euro(d.price)} en ${storeName}. Más barato en ${cheapestName}: ${euro(low)}`]
      .map((s) => (restNames.length && s.length < 120 ? `${s}; también lo comparamos en ${joinNames(restNames)}.` : `${s}.`))[0];
const extra = ' Con ingredientes e información nutricional.';
const description = d.info.ingredients && baseDescription.length + extra.length <= 160 ? baseDescription + extra : baseDescription;

const digits = (d.ean ?? '').replace(/\D/g, '');
const gtin = digits.length === 13 ? { gtin13: digits } : digits.length === 8 ? { gtin8: digits } : digits.length === 14 ? { gtin14: digits } : digits ? { gtin: digits } : {};
const url = new URL(productPath(store, id), Astro.site).href;

const schemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { name: 'Comparador', item: new URL('/', Astro.site).href },
      { name: storeName, item: new URL(`/supermercados/${storeSlug}/`, Astro.site).href },
      { name: d.label, item: url },
    ].map((c, i) => ({ '@type': 'ListItem', position: i + 1, ...c })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: d.label,
    ...(d.image ? { image: d.image } : {}),
    ...(d.brand ? { brand: { '@type': 'Brand', name: d.brand } } : {}),
    ...(d.category ? { category: d.category } : {}),
    description: d.info.description ?? description,
    ...gtin,
    url,
    offers: {
      '@type': 'AggregateOffer',
      priceCurrency: 'EUR',
      lowPrice: low.toFixed(2),
      highPrice: high.toFixed(2),
      offerCount: offers.length,
      offers: offers.map((o) => ({
        '@type': 'Offer',
        price: o.price.toFixed(2),
        priceCurrency: 'EUR',
        ...(o === d ? { url } : {}),
        seller: { '@type': 'Organization', name: STORE_BY_KEY[o.store].name },
      })),
    },
  },
];
---

<Layout title={title} description={description} jsonld={schemas}>
  <ProductPage client:load store={store} id={id} initial={d} initialSame={same} related={related} />
</Layout>
