---
// Anuncios laterales de AdSense a los lados del contenido: los dos de 300 px
// de ancho y tan altos como quepa en la ventana (de 250 a 1050 px; AdSense
// sirve el formato más grande que entre: 300×1050, 300×600, 300×250…).
//
// - Solo en pantallas anchas: el contenido llega a 1320 px y cada lateral
//   (300 px) cabe desde 1960 px de lienzo. En portátiles Layout.astro reduce
//   la web (zoom) para que el lienzo llegue a 2000 px. Cada uno se muestra y
//   se pide solo si cabe (no se carga ningún anuncio oculto).
// - El alto se fija al pedir el anuncio (AdSense no lo cambia después).
// - `after`: selector CSS de un elemento tras el cual empiezan los laterales.
//   En la portada es la sección de bienvenida (`.cmp-hero`): mientras se ve,
//   no hay anuncios; cuando sale de la pantalla, aparecen.
// - El anuncio solo se pide la primera vez que el lateral es visible.
// - Los laterales van en el margen, sin tapar contenido.
interface Props {
  after?: string;
}
const { after } = Astro.props;

const CLIENT = 'ca-pub-9749911986318862';
const SLOT_LEFT = '5392204033';
const SLOT_RIGHT = '3037503430';
---

<aside class="qf-rail qf-rail-left" aria-label="Publicidad" data-after={after} hidden>
  <ins
    class="adsbygoogle"
    style="display:inline-block;width:300px;height:600px"
    data-ad-client={CLIENT}
    data-ad-slot={SLOT_LEFT}
  ></ins>
</aside>
<aside class="qf-rail qf-rail-right" aria-label="Publicidad" data-after={after} hidden>
  <ins
    class="adsbygoogle"
    style="display:inline-block;width:300px;height:600px"
    data-ad-client={CLIENT}
    data-ad-slot={SLOT_RIGHT}
  ></ins>
</aside>

<style is:global>
  .qf-rail {
    position: fixed;
    top: 84px;
    width: 300px;
    /* Hasta 16 px del borde inferior (en px del lienzo, compensando el zoom). */
    height: clamp(250px, calc(100vh / var(--qf-zoom, 1) - 100px), 1050px);
    z-index: 5;
  }
  .qf-rail[hidden] { display: none; }
  .qf-rail-left { left: calc(50% - 972px); }
  .qf-rail-right { right: calc(50% - 972px); }
  /* Qué lateral cabe lo decide el script de escala de Layout.astro (clases
     qf-rail-l / qf-rail-r en <html>), que tiene en cuenta el zoom aplicado. */
  html:not(.qf-rail-l) .qf-rail-left { display: none !important; }
  html:not(.qf-rail-r) .qf-rail-right { display: none !important; }
</style>

<script>
  (function () {
    const rails = Array.from(document.querySelectorAll<HTMLElement>('.qf-rail'));
    if (!rails.length) return;
    const pushed = new WeakSet<HTMLElement>();
    const after = rails[0].dataset.after;

    function show(on: boolean) {
      for (const r of rails) {
        r.hidden = !on;
        // innerHeight 0 = pestaña aún sin pintar: se espera para medir bien el alto.
        if (on && window.innerHeight > 0 && getComputedStyle(r).display !== 'none' && !pushed.has(r)) {
          pushed.add(r);
          // El anuncio ocupa todo el alto del lateral en este momento (px CSS).
          const ins = r.querySelector<HTMLElement>('ins');
          if (ins) ins.style.height = Math.floor(parseFloat(getComputedStyle(r).height)) + 'px';
          try {
            ((window as any).adsbygoogle = (window as any).adsbygoogle || []).push({});
          } catch (e) {}
        }
      }
    }

    function update() {
      if (!after) return show(true);
      const el = document.querySelector(after);
      // Sin la sección de referencia (otra vista de la home) no hay laterales.
      if (!el) return show(false);
      show(el.getBoundingClientRect().bottom < 90);
    }

    window.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    // La home pinta su contenido con React: reintenta cuando cambia el DOM.
    if (after) new MutationObserver(update).observe(document.querySelector('main') || document.body, { childList: true, subtree: true });
    update();
  })();
</script>
