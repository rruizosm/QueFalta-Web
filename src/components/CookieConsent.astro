---
// Consentimiento de cookies con la CMP de Google (AdSense → Privacidad y
// mensajes → Mensaje del RGPD). Es una CMP certificada por Google e integrada
// con el TCF de IAB, requisito para servir anuncios en el EEE y Reino Unido.
// El aviso en sí (textos, botones, idiomas) se configura en AdSense: aquí solo
// se carga el script y se conecta Google Analytics al consentimiento.
//
// Google Analytics usa el modo de consentimiento AVANZADO: gtag.js se carga
// siempre (tras el evento load, para no competir con el render) con todo
// denegado. Sin consentimiento NO escribe ni lee cookies: solo manda pings
// sin identificadores que Google usa para modelizar las visitas de quien
// rechaza. Cuando la CMP comunica analytics_storage = 'granted', gtag pasa a
// medir con cookies (_ga, _ga_*) sin recargar nada.
//
// Va dentro del <head> (lo incluye Layout.astro) para que los valores por
// defecto del modo de consentimiento queden fijados antes que cualquier
// etiqueta de Google.
const GA_ID = 'G-GE1347XYRH';
const ADSENSE_CLIENT = 'ca-pub-9749911986318862';
---

<script is:inline define:vars={{ GA_ID }}>
  (function () {
    var w = window;
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () { w.dataLayer.push(arguments); };

    // Todo denegado hasta que la CMP diga lo contrario.
    w.gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });

    // Con anuncios denegados, quita también los identificadores de anuncios de
    // los pings sin cookies.
    w.gtag('set', 'ads_data_redaction', true);

    // gtag.js se descarga tras load, pero gtag('config') (que dispara el
    // page_view) espera a saber el consentimiento. Si no, el page_view sale
    // como "denegado" aunque el usuario ya hubiera aceptado: la CMP comunica
    // su consentimiento guardado con gtag('consent', 'update', …) un poco
    // después, y wait_for_update solo cubre 500 ms.
    // Se manda el config en cuanto pasa una de estas cosas:
    //   - llega un 'consent update' a dataLayer (decisión guardada o recién tomada);
    //   - la CMP muestra el aviso (aún no ha decidido → se mide sin cookies);
    //   - la CMP dice que el RGPD no aplica (fuera del EEE);
    //   - pasan 3 s desde load (la CMP no carga: bloqueador, red…).
    if (GA_ID) {
      w.gtag('js', new Date());
      var configured = false;
      var sendConfig = function () {
        if (configured) return;
        configured = true;
        w.gtag('config', GA_ID);
      };
      var hasConsentUpdate = function () {
        for (var i = 0; i < w.dataLayer.length; i++) {
          var e = w.dataLayer[i];
          if (e && e[0] === 'consent' && e[1] === 'update') return true;
        }
        return false;
      };
      var tcfHooked = false;
      var poll = setInterval(function () {
        if (configured) return clearInterval(poll);
        if (hasConsentUpdate()) return sendConfig();
        if (!tcfHooked && typeof w.__tcfapi === 'function') {
          tcfHooked = true;
          w.__tcfapi('addEventListener', 2, function (tc, ok) {
            if (!ok || !tc) return;
            if (tc.gdprApplies === false || tc.eventStatus === 'cmpuishown') sendConfig();
          });
        }
      }, 100);
      var loadGA = function () {
        var s = document.createElement('script');
        s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
        document.head.appendChild(s);
        setTimeout(sendConfig, 3000);
      };
      if (document.readyState === 'complete') loadGA();
      else w.addEventListener('load', loadGA);
    }

    // Borra la cookie del banner propio anterior (ya no se usa).
    document.cookie = 'qf_consent=; Max-Age=0; Path=/';

    // "Configurar cookies" (pie y /cookies/) reabre el aviso de Google.
    w.googlefc = w.googlefc || {};
    w.googlefc.callbackQueue = w.googlefc.callbackQueue || [];
    w.qfShowCookieBanner = function () {
      w.googlefc.callbackQueue.push(function () {
        if (typeof w.googlefc.showRevocationMessage === 'function') w.googlefc.showRevocationMessage();
      });
    };
    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest && e.target.closest('[data-qf-cookie-settings]');
      if (!t) return;
      e.preventDefault();
      w.qfShowCookieBanner();
    });
  })();
</script>

<!-- CMP de Google (aviso de cookies), etiqueta propia de Privacidad y mensajes.
     Se carga PRONTO y aparte de AdSense: es quien comunica el consentimiento
     guardado a Analytics, y si esperase al AdSense diferido el page_view
     saldría siempre como denegado. El iframe googlefcPresent avisa a
     adsbygoogle.js de que la CMP ya está en la página (no la carga dos veces). -->
<script is:inline async src={`https://fundingchoicesmessages.google.com/i/${ADSENSE_CLIENT.replace('ca-', '')}?ers=1`}></script>
<script is:inline>
  (function () {
    function signalGooglefcPresent() {
      if (window.frames['googlefcPresent']) return;
      if (!document.body) return setTimeout(signalGooglefcPresent, 0);
      var f = document.createElement('iframe');
      f.style.cssText = 'width:0;height:0;border:none;z-index:-1000;left:-1000px;top:-1000px;display:none';
      f.name = 'googlefcPresent';
      document.body.appendChild(f);
    }
    signalGooglefcPresent();
  })();
</script>

<!-- Google AdSense: anuncios. Se carga en cuanto un hueco cercano a la pantalla
     pide su anuncio (window.qfLoadAds, lo llama pushAd en AdInFeed.jsx): si no,
     el de arriba de la ficha salía en blanco ~5 s. En las páginas sin ningún
     anuncio a la vista sigue DIFERIDO (primera interacción o 4 s después de
     load) para no competir con el render. Los adsbygoogle.push() anteriores a
     la descarga quedan en cola y se sirven cuando llega el script. -->
<script is:inline define:vars={{ ADSENSE_CLIENT }}>
  (function () {
    var started = false;
    function start() {
      if (started) return;
      started = true;
      ['scroll', 'pointerdown', 'keydown', 'touchstart', 'mousemove'].forEach(function (ev) {
        window.removeEventListener(ev, start);
      });
      var s = document.createElement('script');
      s.async = true;
      s.crossOrigin = 'anonymous';
      s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=' + ADSENSE_CLIENT;
      document.head.appendChild(s);
    }
    window.qfLoadAds = start;
    ['scroll', 'pointerdown', 'keydown', 'touchstart', 'mousemove'].forEach(function (ev) {
      window.addEventListener(ev, start, { passive: true, once: true });
    });
    function later() { setTimeout(start, 4000); }
    if (document.readyState === 'complete') later();
    else window.addEventListener('load', later);
  })();
</script>
