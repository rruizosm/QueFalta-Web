---
// Consentimiento de cookies con la CMP de Google (AdSense → Privacidad y
// mensajes → Mensaje del RGPD). Es una CMP certificada por Google e integrada
// con el TCF de IAB, requisito para servir anuncios en el EEE y Reino Unido.
// El aviso en sí (textos, botones, idiomas) se configura en AdSense: aquí solo
// se carga el script y se conecta Google Analytics al consentimiento.
//
// Google Analytics usa el modo de consentimiento en modo BÁSICO: gtag.js NO se
// descarga hasta que la CMP comunica analytics_storage = 'granted'. Sin
// consentimiento no se envía nada a Google Analytics.
//
// Va dentro del <head> (lo incluye Layout.astro) para que los valores por
// defecto del modo de consentimiento queden fijados antes que cualquier
// etiqueta de Google.
const GA_ID = 'G-GE1347XYRH';
const ADSENSE_CLIENT = 'ca-pub-9749911986318862';
---

<script is:inline define:vars={{ GA_ID }}>
  (function () {
    var w = window;
    w.dataLayer = w.dataLayer || [];
    w.gtag = function () { w.dataLayer.push(arguments); };

    // Todo denegado hasta que la CMP diga lo contrario.
    w.gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      wait_for_update: 500,
    });

    // Carga GA4 la primera vez que llega analytics_storage = 'granted'.
    var gaLoaded = false;
    function loadGA() {
      if (gaLoaded || !GA_ID) return;
      gaLoaded = true;
      var s = document.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtag/js?id=' + GA_ID;
      document.head.appendChild(s);
      w.gtag('js', new Date());
      w.gtag('config', GA_ID);
    }
    function check(entry) {
      if (entry && entry[0] === 'consent' && entry[2] && entry[2].analytics_storage === 'granted') {
        loadGA();
      }
    }
    // La CMP de Google comunica el consentimiento con gtag('consent', 'update', …),
    // es decir, empujando a dataLayer: lo vigilamos ahí.
    var push = w.dataLayer.push;
    w.dataLayer.push = function () {
      for (var i = 0; i < arguments.length; i++) check(arguments[i]);
      return push.apply(w.dataLayer, arguments);
    };

    // Borra la cookie del banner propio anterior (ya no se usa).
    document.cookie = 'qf_consent=; Max-Age=0; Path=/';

    // "Configurar cookies" (pie y /cookies/) reabre el aviso de Google.
    w.googlefc = w.googlefc || {};
    w.googlefc.callbackQueue = w.googlefc.callbackQueue || [];
    w.qfShowCookieBanner = function () {
      w.googlefc.callbackQueue.push(function () {
        if (typeof w.googlefc.showRevocationMessage === 'function') w.googlefc.showRevocationMessage();
      });
    };
    document.addEventListener('click', function (e) {
      var t = e.target && e.target.closest && e.target.closest('[data-qf-cookie-settings]');
      if (!t) return;
      e.preventDefault();
      w.qfShowCookieBanner();
    });
  })();
</script>

<!-- Google AdSense: verificación del sitio, anuncios y carga de la CMP de Google. -->
<script
  is:inline
  async
  src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT}`}
  crossorigin="anonymous"
></script>
