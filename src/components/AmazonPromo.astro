---
// Pop-up promocional (afiliado de Amazon) que sube desde abajo.
// - Aparece a los PROMO_DELAY ms o al pasar del 35 % de scroll, lo que llegue antes.
// - Espera a que la CMP de Google (aviso de cookies) esté cerrada para no taparla.
// - Al cerrarlo o pulsar el enlace no vuelve a salir en PROMO_SNOOZE_DAYS días.
// - Reglas de Amazon Asociados: sin precio copiado, sin imagen alojada aquí
//   (la ilustración es vectorial propia); `img` solo con URL de la PA-API.
// - Etiqueta de campaña (Black Friday): se oculta sola a partir de `tagUntil`.
//   Solo mostrarla si el producto está de verdad en oferta en Amazon.
import { AMAZON_TAG } from '../data/cocina.js';

interface Props { lang?: 'es' | 'ca' }
const { lang = 'es' } = Astro.props;

// Producto promocionado. Cambiar `id` al cambiar de producto para que vuelva a
// mostrarse a quien cerró el anterior.
const PROMO = {
  id: 'yashe-vidrio-bf-2026',
  asin: 'B0H2N9TFRY',
  img: '', // URL de la PA-API cuando esté disponible (tras 3 ventas)
  tagUntil: '2026-12-01T00:00:00+01:00', // fin de Black Friday + Cyber Monday
};
const PROMO_DELAY = 9000;
const PROMO_SNOOZE_DAYS = 3;

const T = lang === 'ca'
  ? {
      tag: 'Black Friday',
      tagSub: 'Oferta',
      kicker: 'Tria de QuéFalta',
      title: 'Tuppers de vidre hermètics',
      points: ['Sense olors ni taques', 'Per a les sobres i els tuppers de la setmana'],
      cta: 'Veure l\'oferta a Amazon',
      ctaNoTag: 'Veure a Amazon',
      close: 'Tancar',
      label: 'Producte recomanat',
      disclosure: "Enllaç d'afiliat: com a Afiliat d'Amazon, QuéFalta obté ingressos per les compres adscrites.",
    }
  : {
      tag: 'Black Friday',
      tagSub: 'Oferta',
      kicker: 'Elegido por QuéFalta',
      title: 'Tuppers de vidrio herméticos',
      points: ['Sin olores ni manchas', 'Para las sobras y los tuppers de la semana'],
      cta: 'Ver la oferta en Amazon',
      ctaNoTag: 'Ver en Amazon',
      close: 'Cerrar',
      label: 'Producto recomendado',
      disclosure: 'Enlace de afiliado: como Afiliado de Amazon, QuéFalta obtiene ingresos por las compras adscritas.',
    };

const href = `https://www.amazon.es/dp/${PROMO.asin}?tag=${AMAZON_TAG}`;
// No tiene sentido en la página que ya lista los productos del hogar.
const path = Astro.url.pathname;
const skip = path.startsWith('/cocina') || path.startsWith('/ca/cuina');
---

{!skip && (
  <aside class="qf-promo has-tag" id="qf-promo" role="dialog" aria-modal="false" aria-label={T.label} hidden
    data-id={PROMO.id} data-delay={PROMO_DELAY} data-snooze={PROMO_SNOOZE_DAYS} data-tag-until={PROMO.tagUntil}>
    <button type="button" class="qf-promo-close" data-promo-close aria-label={T.close}>
      <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"/></svg>
    </button>

    <a class="qf-promo-body" href={href} target="_blank" rel="sponsored nofollow noopener" data-promo-go>
      <span class="qf-promo-media">
        <span class="qf-promo-tag" data-promo-tag>
          <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M3 12V4a1 1 0 0 1 1-1h8l9 9-9 9-9-9z" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/><circle cx="8" cy="8" r="1.8" fill="currentColor"/></svg>
          <span><small>{T.tagSub}</small>{T.tag}</span>
        </span>
        <span class="qf-promo-burst" aria-hidden="true"></span>
        {PROMO.img
          ? <img src={PROMO.img} alt="" width="160" height="160" loading="lazy" />
          : (
            <svg viewBox="0 0 160 140" aria-hidden="true" class="qf-promo-art">
              <ellipse cx="80" cy="130" rx="68" ry="7" fill="#000" opacity=".12" />
              <rect x="34" y="34" width="96" height="16" rx="6" fill="#2f6cb5" />
              <rect x="44" y="38" width="10" height="8" rx="2" fill="#5b8fd0" />
              <rect x="110" y="38" width="10" height="8" rx="2" fill="#5b8fd0" />
              <rect x="38" y="48" width="88" height="40" rx="9" fill="#dff0fb" stroke="#a9cbe6" stroke-width="2" />
              <rect x="42" y="62" width="80" height="22" rx="6" fill="#f4e6c4" />
              <circle cx="56" cy="66" r="5" fill="#7bbf6a" /><circle cx="70" cy="70" r="4" fill="#ef6b5b" />
              <circle cx="96" cy="67" r="5" fill="#7bbf6a" /><circle cx="110" cy="71" r="4" fill="#f6b24a" />
              <rect x="14" y="72" width="84" height="15" rx="6" fill="#2f6cb5" />
              <rect x="24" y="76" width="9" height="7" rx="2" fill="#5b8fd0" />
              <rect x="79" y="76" width="9" height="7" rx="2" fill="#5b8fd0" />
              <rect x="18" y="85" width="76" height="40" rx="9" fill="#e9f6fd" stroke="#a9cbe6" stroke-width="2" />
              <rect x="22" y="98" width="68" height="23" rx="6" fill="#f6c27a" />
              <path d="M28 104q6-5 12 0t12 0 12 0 12 0 10 0" stroke="#e39b45" stroke-width="2.4" fill="none" stroke-linecap="round" />
              <path d="M28 112q6-5 12 0t12 0 12 0 12 0 10 0" stroke="#e39b45" stroke-width="2.4" fill="none" stroke-linecap="round" />
              <circle cx="46" cy="101" r="3.5" fill="#d9483b" /><circle cx="68" cy="109" r="3.5" fill="#d9483b" />
              <rect x="104" y="92" width="44" height="10" rx="5" fill="#2f6cb5" />
              <rect x="106" y="100" width="40" height="25" rx="10" fill="#e9f6fd" stroke="#a9cbe6" stroke-width="2" />
              <rect x="109" y="108" width="34" height="14" rx="7" fill="#9cc98a" />
              <path d="M24 92v18M44 55v14M112 104v8" stroke="#fff" stroke-width="3" stroke-linecap="round" opacity=".9" />
            </svg>
          )}
      </span>

      <span class="qf-promo-text">
        <span class="qf-promo-kicker">
          <svg viewBox="0 0 24 24" width="13" height="13" aria-hidden="true"><path d="M12 2l2.9 6.3 6.9.7-5.2 4.6 1.5 6.8L12 17l-6.1 3.4 1.5-6.8L2.2 9l6.9-.7z" fill="currentColor"/></svg>
          {T.kicker}
        </span>
        <span class="qf-promo-title">{T.title}</span>
        <span class="qf-promo-points">
          {T.points.map((p) => (
            <span class="qf-promo-point">
              <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
              {p}
            </span>
          ))}
        </span>
      </span>

      <span class="qf-promo-cta">
        <span data-cta-tag>{T.cta}</span><span data-cta-notag hidden>{T.ctaNoTag}</span>
        <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2.4" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </span>
    </a>
    <p class="qf-promo-disc">{T.disclosure}</p>
  </aside>
)}

<script is:inline>
  (function () {
    var el = document.getElementById('qf-promo');
    if (!el) return;
    var KEY = 'qf-promo-' + el.dataset.id;
    var snoozeMs = Number(el.dataset.snooze) * 864e5;
    try {
      var until = Number(localStorage.getItem(KEY) || 0);
      if (until && Date.now() < until) return;
    } catch (e) {}

    // Pasada la campaña, fuera la etiqueta y el texto de «oferta».
    var tagUntil = Date.parse(el.dataset.tagUntil || '');
    if (tagUntil && Date.now() >= tagUntil) {
      el.classList.remove('has-tag');
      el.querySelector('[data-promo-tag]').remove();
      el.querySelector('[data-cta-tag]').hidden = true;
      el.querySelector('[data-cta-notag]').hidden = false;
    }

    var shown = false;
    function cmpOpen() {
      var c = document.querySelector('.fc-consent-root');
      return !!(c && c.offsetParent !== null && getComputedStyle(c).display !== 'none');
    }
    function show() {
      if (shown) return;
      if (cmpOpen()) { setTimeout(show, 2000); return; }
      shown = true;
      window.removeEventListener('scroll', onScroll);
      el.hidden = false;
      // Forzar el layout con el estado inicial y luego animar (sin rAF, que se
      // congela con la pestaña en segundo plano).
      void el.offsetWidth;
      el.classList.add('is-in');
    }
    function hide() {
      try { localStorage.setItem(KEY, String(Date.now() + snoozeMs)); } catch (e) {}
      el.classList.remove('is-in');
      setTimeout(function () { el.hidden = true; }, 450);
    }
    function onScroll() {
      var h = document.documentElement;
      if ((h.scrollTop + innerHeight) / h.scrollHeight > 0.35) show();
    }
    setTimeout(show, Number(el.dataset.delay) || 9000);
    window.addEventListener('scroll', onScroll, { passive: true });
    el.querySelector('[data-promo-close]').addEventListener('click', hide);
    el.querySelector('[data-promo-go]').addEventListener('click', function () { setTimeout(hide, 300); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && shown && !el.hidden) hide(); });
  })();
</script>

<style is:global>
  .qf-promo {
    --bf-red: #e11d2e;
    --bf-red-dark: #b3121f;
    position: fixed;
    z-index: 900;
    left: 50%;
    bottom: max(16px, env(safe-area-inset-bottom));
    width: min(460px, calc(100vw - 32px));
    transform: translate(-50%, calc(100% + 40px));
    opacity: 0;
    transition: transform .6s cubic-bezier(.2, 1.3, .35, 1), opacity .35s ease;
    background: var(--surface, #fff);
    color: var(--ink, #111114);
    border-radius: 24px;
    box-shadow: 0 24px 60px rgba(17, 17, 20, .28), 0 2px 8px rgba(17, 17, 20, .1);
    padding: 12px;
    font-family: 'Mulish', system-ui, sans-serif;
  }
  /* Borde rojo de campaña */
  .qf-promo.has-tag { box-shadow: 0 0 0 2px var(--bf-red), 0 24px 60px rgba(225, 29, 46, .28), 0 2px 8px rgba(17, 17, 20, .1); }
  .qf-promo[hidden] { display: none; }
  .qf-promo.is-in { transform: translate(-50%, 0); opacity: 1; }

  .qf-promo-close {
    position: absolute; top: -12px; right: -8px; z-index: 3;
    width: 32px; height: 32px; border-radius: 50%;
    display: grid; place-items: center; cursor: pointer;
    border: 2px solid var(--surface, #fff);
    background: var(--ink, #111114); color: var(--surface, #fff);
    box-shadow: 0 4px 12px rgba(0, 0, 0, .2);
  }
  .qf-promo-close:hover { transform: scale(1.08); }

  .qf-promo-body {
    display: grid;
    grid-template-columns: 140px 1fr;
    grid-template-areas: 'media text' 'cta cta';
    gap: 12px 14px;
    text-decoration: none; color: inherit;
  }

  /* Imagen */
  .qf-promo-media {
    grid-area: media; position: relative;
    height: 140px; border-radius: 18px;
    display: grid; place-items: center; overflow: hidden;
    background: radial-gradient(120% 90% at 50% 100%, #ffe9c7 0%, #eaf3fc 60%, #dcebfa 100%);
  }
  .has-tag .qf-promo-media { background: radial-gradient(120% 90% at 50% 100%, #ffd9d9 0%, #fff1ec 55%, #fde3e3 100%); }
  .qf-promo-media img { width: 100%; height: 100%; object-fit: contain; background: #fff; }
  .qf-promo-art { position: relative; z-index: 1; width: 124px; height: auto; margin-top: 18px; }
  .qf-promo-burst {
    position: absolute; inset: 0;
    background: repeating-conic-gradient(from 0deg at 50% 70%, rgba(255,255,255,.55) 0 8deg, transparent 8deg 22deg);
    opacity: .7;
  }
  .qf-promo.is-in .qf-promo-burst { animation: qf-spin 24s linear infinite; }
  .qf-promo.is-in .qf-promo-art { animation: qf-bob 2.6s ease-in-out .7s 2; }

  /* Etiqueta Black Friday */
  .qf-promo-tag {
    position: absolute; top: 8px; left: 8px; z-index: 2;
    display: inline-flex; align-items: center; gap: 6px;
    background: linear-gradient(180deg, var(--bf-red), var(--bf-red-dark));
    color: #fff; border-radius: 10px; padding: 5px 9px 5px 7px;
    font-family: var(--geo, 'Space Grotesk', sans-serif);
    font-weight: 800; font-size: 13px; line-height: 1; letter-spacing: .01em; text-transform: uppercase;
    box-shadow: 0 6px 14px rgba(225, 29, 46, .45);
    transform: rotate(-4deg);
  }
  .qf-promo-tag > span { display: flex; flex-direction: column; gap: 2px; }
  .qf-promo-tag small { font-size: 9px; font-weight: 700; letter-spacing: .14em; opacity: .85; }
  .qf-promo.is-in .qf-promo-tag { animation: qf-tag-in .7s cubic-bezier(.2, 1.6, .4, 1) .45s both, qf-pulse 1.8s ease-in-out 1.4s 3; }

  /* Texto */
  .qf-promo-text { grid-area: text; display: flex; flex-direction: column; justify-content: center; gap: 6px; min-width: 0; padding-right: 8px; }
  .qf-promo-kicker {
    display: inline-flex; align-items: center; gap: 5px;
    font-size: 11.5px; font-weight: 800; letter-spacing: .05em; text-transform: uppercase;
    color: var(--accent, #2f6cb5);
  }
  .qf-promo-kicker svg { color: #f5a524; }
  .qf-promo-title { font-family: var(--geo, 'Space Grotesk', sans-serif); font-weight: 700; font-size: 21px; line-height: 1.12; letter-spacing: -.01em; }
  .qf-promo-points { display: flex; flex-direction: column; gap: 4px; margin-top: 2px; }
  .qf-promo-point { display: flex; align-items: flex-start; gap: 6px; font-size: 13.5px; line-height: 1.3; color: var(--ink-soft, #5d5d66); }
  .qf-promo-point svg { flex: none; margin-top: 1px; color: var(--ok, #2faa4f); }

  /* Botón */
  .qf-promo-cta {
    grid-area: cta; position: relative; overflow: hidden;
    display: flex; align-items: center; justify-content: center; gap: 8px;
    min-height: 50px; border-radius: 14px;
    background: linear-gradient(180deg, #ffc53d, #ffa41c);
    color: #111114; font-weight: 800; font-size: 16px;
    box-shadow: 0 6px 16px rgba(255, 164, 28, .45), inset 0 -2px 0 rgba(0, 0, 0, .08);
    transition: transform .15s ease, box-shadow .15s ease;
  }
  .has-tag .qf-promo-cta {
    background: linear-gradient(180deg, var(--bf-red), var(--bf-red-dark));
    color: #fff;
    box-shadow: 0 8px 20px rgba(225, 29, 46, .4), inset 0 -2px 0 rgba(0, 0, 0, .15);
  }
  .qf-promo-cta::after {
    content: ''; position: absolute; top: 0; bottom: 0; left: -40%; width: 30%;
    background: linear-gradient(100deg, transparent, rgba(255, 255, 255, .55), transparent);
    transform: skewX(-20deg);
  }
  .qf-promo.is-in .qf-promo-cta::after { animation: qf-shine 3.2s ease-in-out 1.2s infinite; }
  .qf-promo-body:hover .qf-promo-cta { transform: translateY(-1px); }
  .qf-promo-body:active .qf-promo-cta { transform: translateY(1px); }

  .qf-promo-disc { margin: 8px 4px 0; font-size: 10.5px; line-height: 1.35; color: var(--ink-faint, #9a9aa3); text-align: center; }

  @keyframes qf-bob { 50% { transform: translateY(-5px) rotate(-1.5deg); } }
  @keyframes qf-spin { to { transform: rotate(360deg) scale(1.6); } }
  @keyframes qf-shine { 0% { left: -40%; } 45%, 100% { left: 130%; } }
  @keyframes qf-tag-in { from { transform: rotate(-30deg) scale(.3); opacity: 0; } to { transform: rotate(-4deg) scale(1); opacity: 1; } }
  @keyframes qf-pulse { 50% { transform: rotate(-4deg) scale(1.1); } }

  @media (max-width: 420px) {
    .qf-promo-body { grid-template-columns: 112px 1fr; gap: 10px 12px; }
    .qf-promo-media { height: 118px; }
    .qf-promo-art { width: 102px; margin-top: 16px; }
    .qf-promo-tag { font-size: 11.5px; padding: 4px 7px 4px 6px; }
    .qf-promo-tag svg { width: 12px; height: 12px; }
    .qf-promo-title { font-size: 18px; }
    .qf-promo-point { font-size: 12.5px; }
    .qf-promo-cta { min-height: 46px; font-size: 15px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .qf-promo { transition: opacity .2s ease; }
    .qf-promo.is-in .qf-promo-art,
    .qf-promo.is-in .qf-promo-burst,
    .qf-promo.is-in .qf-promo-cta::after { animation: none; }
    .qf-promo.is-in .qf-promo-tag { animation: none; }
  }
</style>
