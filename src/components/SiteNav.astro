---
// Navbar global de QuéFalta. Se muestra en todas las páginas (landing y
// subpáginas). La home es el comparador; la presentación de la app está en
// /como-funciona/ (en catalán, /ca/comparador/ y /ca/).
interface Props {
  lang?: 'es' | 'ca';
  /** Versiones de idioma de ESTA página: el selector cambia de idioma sin
      cambiar de página. Sin par, el otro idioma aparece desactivado. */
  alternates?: { es: string; ca: string };
}
const { lang = 'es', alternates } = Astro.props;

const LINKS = lang === 'ca'
  ? [
      { href: '/ca/comparador/', label: 'Comparador' },
      { href: '/ca/', label: 'Com funciona' },
      { href: '/ca/supermercats/', label: 'Supermercats' },
      { href: '/ca/preguntes/', label: 'Preguntes' },
      { href: '/novedades/', label: 'Novetats' },
    ]
  : [
      { href: '/', label: 'Comparador' },
      { href: '/como-funciona/', label: 'Cómo funciona' },
      { href: '/supermercados/', label: 'Supermercados' },
      { href: '/preguntas/', label: 'Preguntas' },
      { href: '/novedades/', label: 'Novedades' },
      { href: '/apoyar/', label: 'Apoyar' },
    ];
const CTA = lang === 'ca'
  ? { href: '/ca/#descarrega', label: "Descarrega l'app" }
  : { href: '/como-funciona/#descargar', label: 'Descargar la app' };
const HOME = lang === 'ca' ? '/ca/comparador/' : '/';
// Selector de idioma: lleva a ESTA página en el otro idioma. Si no está
// traducida, el idioma queda desactivado en vez de llevar a otra página.
const LANGS = [
  { code: 'es', label: 'ES', name: 'Español', missing: 'Esta página aún no está en castellano' },
  { code: 'ca', label: 'CA', name: 'Català', missing: 'Aquesta pàgina encara no està en català' },
].map((l) => ({
  ...l,
  href: alternates?.[l.code] ?? (l.code === lang ? Astro.url.pathname : null),
}));
const T = lang === 'ca'
  ? { nav: 'Navegació principal', home: 'QuéFalta, inici', menu: 'Obrir menú' }
  : { nav: 'Navegación principal', home: 'QuéFalta, inicio', menu: 'Abrir menú' };
---

<nav class="qf-nav" id="qf-nav" aria-label={T.nav}>
  <div class="qf-nav-inner">
    <a href={HOME} class="qf-word" aria-label={T.home}>
      <img src="/quefalta-logo-blue.png" alt="" class="qf-logo" width="30" height="30" />
      <span class="qf-word-txt">Qué<span>Falta</span></span>
    </a>
    <div class="qf-nav-right" id="qf-nav-menu">
      <div class="qf-nav-links">
        {LINKS.map((l) => (
          <a href={l.href} class="qf-nav-link">{l.label}</a>
        ))}
      </div>
      <div class="qf-nav-actions">
        <div class="qf-lang" role="group" aria-label="Idioma">
          {LANGS.map((l) => l.href ? (
            <a
              href={l.href} hreflang={l.code} lang={l.code} title={l.name}
              class={`qf-lang-opt${l.code === lang ? ' is-on' : ''}`}
              aria-current={l.code === lang ? 'true' : undefined}
            >{l.label}</a>
          ) : (
            <span class="qf-lang-opt is-off" lang={l.code} title={l.missing} aria-disabled="true">{l.label}</span>
          ))}
        </div>
        <a href={CTA.href} class="qf-nav-cta">
          {CTA.label}
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 4v11M7 10.5l5 5 5-5M5 20h14" /></svg>
        </a>
      </div>
    </div>
    <button
      type="button" class="qf-nav-toggle" id="qf-nav-toggle"
      aria-label={T.menu} aria-expanded="false" aria-controls="qf-nav-menu"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</nav>

<script>
  // Añade un borde inferior al hacer scroll, igual que en la landing.
  const nav = document.getElementById('qf-nav');
  if (nav) {
    const onScroll = () => nav.classList.toggle('scrolled', window.scrollY > 8);
    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();

    // Menú móvil (hamburguesa): abre/cierra el panel desplegable.
    const toggle = document.getElementById('qf-nav-toggle');
    const closeMenu = () => {
      nav.classList.remove('open');
      if (toggle) toggle.setAttribute('aria-expanded', 'false');
    };
    if (toggle) {
      toggle.addEventListener('click', () => {
        const open = nav.classList.toggle('open');
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      });
      // Cerrar al pulsar un enlace o al ensanchar a escritorio.
      nav.querySelectorAll('.qf-nav-right a').forEach((a) => a.addEventListener('click', closeMenu));
      document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeMenu(); });
      window.addEventListener('resize', () => { if (window.innerWidth > 1120) closeMenu(); });
    }

    // Al cambiar de idioma se conserva la vista del comparador (?super=…&cat=…).
    nav.querySelectorAll('a.qf-lang-opt').forEach((a) => {
      a.addEventListener('click', () => { a.search = location.search; });
    });

    // Marca en color de acento el enlace de la sección/página activa.
    const links = Array.from(nav.querySelectorAll('.qf-nav-link'));
    const norm = (p) => (p.length > 1 ? p.replace(/\/$/, '') : p);
    const path = norm(location.pathname);
    const activate = (link) => links.forEach((l) => l.classList.toggle('is-active', l === link));

    // Enlaces a otras páginas (sin ancla): se marcan por la URL actual.
    const pageLink = links.find((l) => {
      const u = new URL(l.href, location.origin);
      return !u.hash && norm(u.pathname) === path;
    });

    // Enlaces ancla de la página actual (#...): se comparan contra la ruta actual.
    const anchors = links
      .map((l) => {
        const u = new URL(l.href, location.origin);
        return u.hash && norm(u.pathname) === path ? { link: l, id: u.hash.slice(1) } : null;
      })
      .filter(Boolean);

    if (anchors.length) {
      // Marca inmediata al hacer clic.
      anchors.forEach((a) => a.link.addEventListener('click', () => activate(a.link)));
      // Scroll spy: resalta la sección que cruza el centro de la pantalla.
      const byEl = new Map();
      anchors.forEach((a) => {
        const el = document.getElementById(a.id);
        if (el) byEl.set(el, a.link);
      });
      if (byEl.size) {
        const spy = new IntersectionObserver(
          (entries) => entries.forEach((e) => { if (e.isIntersecting) activate(byEl.get(e.target)); }),
          { rootMargin: '-45% 0px -50% 0px', threshold: 0 }
        );
        byEl.forEach((_, el) => spy.observe(el));
      }
    } else if (pageLink) {
      activate(pageLink);
    }
  }
</script>

<style>
  /* Cabecera "de producto": logo a la izquierda, enlaces centrados y acciones
     (idioma + descarga) a la derecha. Translúcida, con borde y sombra suave al
     hacer scroll. */
  .qf-nav {
    position: sticky; top: 0; z-index: 60;
    background: color-mix(in srgb, var(--paper) 80%, transparent);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }
  .qf-nav.scrolled {
    border-bottom-color: var(--border);
    box-shadow: 0 8px 24px -20px rgba(17, 17, 20, 0.4);
  }
  .qf-nav-inner {
    max-width: 1200px; margin: 0 auto; padding: 0 40px; height: 64px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .qf-word { display: inline-flex; align-items: center; gap: 10px; flex: 0 0 auto; font-family: var(--geo); font-weight: 800; font-size: 21px; letter-spacing: -0.04em; color: var(--ink); }
  .qf-logo { width: 30px; height: 30px; object-fit: contain; display: block; }
  .qf-word-txt span { color: var(--accent); }

  .qf-nav-right { flex: 1; display: flex; align-items: center; justify-content: space-between; gap: 24px; min-width: 0; }
  .qf-nav-links { flex: 1; display: flex; align-items: center; justify-content: center; gap: 2px; }
  .qf-nav-link {
    position: relative; padding: 8px 13px; border-radius: 10px;
    font-size: 14.5px; font-weight: 500; color: var(--ink-soft);
    transition: color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .qf-nav-link:hover { color: var(--ink); background: var(--paper-2); }
  /* Sección o página activa: texto en acento + raya inferior. Vive aquí (y no
     solo en landing.css) para que también funcione en las subpáginas como
     Novedades o Apoyar, que no cargan landing.css. */
  .qf-nav-link.is-active { color: var(--accent); font-weight: 600; }
  .qf-nav-link.is-active::after {
    content: ''; position: absolute; left: 13px; right: 13px; bottom: 1px;
    height: 2px; border-radius: 2px; background: var(--accent);
  }

  .qf-nav-actions { display: flex; align-items: center; gap: 14px; flex: 0 0 auto; }
  .qf-lang {
    display: inline-flex; padding: 3px; border-radius: 10px;
    background: var(--paper-2); border: 1px solid var(--border);
  }
  .qf-lang-opt {
    padding: 4px 9px; border-radius: 7px; font-size: 12px; font-weight: 700; letter-spacing: 0.04em;
    color: var(--ink-faint); transition: color 0.15s var(--ease), background 0.15s var(--ease);
  }
  .qf-lang-opt:hover { color: var(--ink); }
  .qf-lang-opt.is-off, .qf-lang-opt.is-off:hover { color: var(--ink-faint); opacity: 0.55; cursor: not-allowed; }
  .qf-lang-opt.is-on { background: var(--surface); color: var(--ink); box-shadow: 0 1px 3px rgba(17, 17, 20, 0.12); }

  .qf-nav-cta {
    display: inline-flex; align-items: center; gap: 8px;
    font-size: 14px; font-weight: 600; color: #fff; background: var(--accent);
    padding: 10px 18px; border-radius: 12px;
    box-shadow: 0 1px 2px rgba(17, 17, 20, 0.12), inset 0 1px 0 rgba(255, 255, 255, 0.18);
    transition: filter 0.18s var(--ease), transform 0.18s var(--ease), box-shadow 0.18s var(--ease);
  }
  .qf-nav-cta:hover {
    filter: brightness(1.08); transform: translateY(-1px);
    box-shadow: 0 10px 22px -10px color-mix(in srgb, var(--accent) 75%, transparent);
  }
  .qf-nav a:focus-visible, .qf-nav-toggle:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }

  /* Botón hamburguesa: oculto en escritorio, visible en móvil. */
  .qf-nav-toggle { display: none; }

  /* Con 6 enlaces + idioma + CTA la fila va justa por debajo de ~1120px: el
     menú móvil entra antes que el resto de breakpoints (980) del sitio. */
  @media (max-width: 1120px) {
    .qf-nav-inner { padding-left: 20px; padding-right: 20px; height: 60px; }

    /* Hamburguesa de 3 barras que se transforma en «X» al abrir. */
    .qf-nav-toggle {
      display: inline-flex; flex-direction: column; justify-content: center; gap: 5px;
      width: 44px; height: 44px; margin-right: -10px; padding: 0;
      border: 0; background: none; cursor: pointer; -webkit-appearance: none; appearance: none;
    }
    .qf-nav-toggle span {
      display: block; width: 22px; height: 2px; margin: 0 auto; border-radius: 2px;
      background: var(--ink);
      transition: transform 0.25s var(--ease), opacity 0.2s;
    }
    .qf-nav.open .qf-nav-toggle span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .qf-nav.open .qf-nav-toggle span:nth-child(2) { opacity: 0; }
    .qf-nav.open .qf-nav-toggle span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

    /* Panel desplegable: ocupa el ancho bajo la barra; oculto hasta abrir. */
    .qf-nav-right {
      display: none;
      position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; align-items: stretch; gap: 0;
      padding: 6px 20px 20px;
      background: var(--paper); border-bottom: 1px solid var(--border);
      box-shadow: 0 18px 30px -16px rgba(17, 17, 20, 0.22);
    }
    .qf-nav.open .qf-nav-right { display: flex; }
    .qf-nav-links { flex-direction: column; align-items: stretch; gap: 0; }
    .qf-nav-link {
      display: block; font-size: 16px; color: var(--ink); border-radius: 0;
      padding: 14px 4px; border-bottom: 1px solid var(--border);
    }
    .qf-nav-link:hover { background: none; }
    .qf-nav-link.is-active::after { display: none; }
    .qf-nav-actions { margin-top: 18px; gap: 12px; }
    .qf-nav-cta { flex: 1; justify-content: center; padding: 13px 18px; font-size: 15px; }
    .qf-lang-opt { padding: 9px 12px; font-size: 13px; }
  }
</style>
